#!/usr/bin/env bash
# Release on the PROD host, from the deploy checkout: bin/release [tag]
# Refuses a dirty tree; with no tag it tags the current origin/main as rYYYYMMDD-HHMMSS. Builds, tests in the test
# image, brings the stack up, waits for /health, then writes an off-host git bundle. A failing step stops the release.
set -euo pipefail
cd "$(dirname "$0")/.."
[ -f .env ] && { set -a; . ./.env; set +a; }   # BRIEF_PORT / ARCHIVE_DIR, the same values compose reads

[ -z "$(git status --porcelain)" ] || { echo "release: working tree is dirty; commit or discard first" >&2; exit 1; }
git fetch -q --tags origin
TAG="${1:-}"
if [ -z "$TAG" ]; then
  TAG="r$(date +%Y%m%d-%H%M%S)"
  git tag -a "$TAG" -m "release $TAG" origin/main
fi
git -c advice.detachedHead=false checkout -q "$TAG"

docker compose build
docker compose --profile test run --rm test || { echo "release: tests fail in the image; not going live" >&2; exit 1; }
docker compose up -d

URL="http://127.0.0.1:${BRIEF_PORT:-8765}/health"
for _ in $(seq 30); do curl -fsS "$URL" >/dev/null 2>&1 && break || sleep 2; done
curl -fsS "$URL" >/dev/null 2>&1 || { echo "release: $URL not answering after 60 s (docker compose logs api)" >&2; exit 1; }
echo "healthy: $URL"

# Off-host copy of the whole repo (every tag) on the archive mount. A missing mount must not block a release,
# but it must not pass silently either.
BUNDLE_DIR="${ARCHIVE_DIR:-./archive}/daily_brief/repo"
if mkdir -p "$BUNDLE_DIR" && git bundle create "$BUNDLE_DIR/daily_brief.bundle.tmp" --all 2>/dev/null \
   && git bundle verify -q "$BUNDLE_DIR/daily_brief.bundle.tmp" 2>/dev/null \
   && mv -f "$BUNDLE_DIR/daily_brief.bundle.tmp" "$BUNDLE_DIR/daily_brief.bundle"; then
  echo "repo bundle -> $BUNDLE_DIR/daily_brief.bundle"
else
  echo "release: WARNING: could not write the repo bundle to $BUNDLE_DIR (archive mounted?)" >&2
fi
sync
echo "released $TAG"
